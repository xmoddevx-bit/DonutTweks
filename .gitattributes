# Normalize text files to LF in the repository
* text=auto

# Gradle / Kotlin / Java / assets: LF everywhere (gradlew must stay LF)
gradlew            text eol=lf
*.gradle           text eol=lf
*.gradle.kts       text eol=lf
*.properties       text eol=lf
*.java             text eol=lf
*.json             text eol=lf
*.toml             text eol=lf
*.md               text eol=lf

# Windows scripts
*.bat              text eol=crlf
*.cmd              text eol=crlf

# Binaries
*.jar              binary
*.png              binary
